      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="monitorar_di" bpmnElement="monitorar">
        <dc:Bounds x="1310" y="835" width="180" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
