<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Lab" targetNamespace="https://example.org/lab-cicd">
  <bpmn:error id="ErroDeploy" name="Falha técnica no deploy" errorCode="DEPLOY_FAILED" />
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Pool" name="Desenvolver e entregar funcionalidade" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="TO-BE CI CD" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Lane0" name="Cliente">
        <bpmn:flowNodeRef>inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>solicitar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane1" name="PO">
        <bpmn:flowNodeRef>receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>documentar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane2" name="DEV">
        <bpmn:flowNodeRef>desenvolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrigir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane3" name="QA / CI - GitHub Actions">
        <bpmn:flowNodeRef>verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aprovado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bloquear</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane4" name="CD - GitHub Actions">
        <bpmn:flowNodeRef>pages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>habilitado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sem_pages</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>falha</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane5" name="DevOps">
        <bpmn:flowNodeRef>monitorar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio" name="Necessidade">
      <bpmn:outgoing>Flow0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="solicitar" name="Solicitar função checar letras no CNPJ">
      <bpmn:incoming>Flow0</bpmn:incoming>
      <bpmn:outgoing>Flow1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="receber" name="Internalizar demanda do cliente">
      <bpmn:incoming>Flow1</bpmn:incoming>
      <bpmn:outgoing>Flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="documentar" name="Registrar requisitos e critérios de aceitação">
      <bpmn:incoming>Flow2</bpmn:incoming>
      <bpmn:outgoing>Flow3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="desenvolver" name="Desenvolver a alteração">
      <bpmn:incoming>Flow3</bpmn:incoming>
      <bpmn:outgoing>Flow4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="commit" name="Enviar index.html Commit e push na main">
      <bpmn:incoming>Flow4</bpmn:incoming>
      <bpmn:outgoing>Flow5</bpmn:outgoing>
      <bpmn:incoming>Flow9</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="corrigir" name="Analisar logs e corrigir o arquivo">
      <bpmn:incoming>Flow8</bpmn:incoming>
      <bpmn:outgoing>Flow9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="verificar" name="Executar as 3 regras 1  index.html existe 2  contém &lt;title&gt; 3  contém &lt;/html&gt;">
      <bpmn:documentation>Executar sequencialmente: test -f index.html; grep -qi "&lt;title&gt;" index.html; grep -qi "&lt;/html&gt;" index.html. Interromper na primeira falha.</bpmn:documentation>
      <bpmn:incoming>Flow5</bpmn:incoming>
      <bpmn:outgoing>Flow6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="aprovado" name="CI aprovada?">
      <bpmn:incoming>Flow6</bpmn:incoming>
      <bpmn:outgoing>Flow7</bpmn:outgoing>
      <bpmn:outgoing>Flow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="bloquear" name="Registrar erro e bloquear publicação Versão anterior mantida">
      <bpmn:incoming>Flow7</bpmn:incoming>
      <bpmn:outgoing>Flow8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="pages" name="Verificar se o Pages está habilitado">
      <bpmn:incoming>Flow10</bpmn:incoming>
      <bpmn:outgoing>Flow11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="habilitado" name="Pages ligado?">
      <bpmn:incoming>Flow11</bpmn:incoming>
      <bpmn:outgoing>Flow12</bpmn:outgoing>
      <bpmn:outgoing>Flow13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="preparar" name="Carimbar autor, data e commit Empacotar o site">
      <bpmn:incoming>Flow12</bpmn:incoming>
      <bpmn:outgoing>Flow14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="publicar" name="Publicar artefato no GitHub Pages">
      <bpmn:incoming>Flow14</bpmn:incoming>
      <bpmn:outgoing>Flow15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="sem_pages" name="Sem publicação Emitir aviso de Pages">
      <bpmn:incoming>Flow13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="erro" name="" attachedToRef="publicar" cancelActivity="true">
      <bpmn:outgoing>Flow16</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef" errorRef="ErroDeploy" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="falha" name="Falha técnica DevOps deve tratar">
      <bpmn:incoming>Flow16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="monitorar" name="Conferir URL e versão Monitorar o sistema">
      <bpmn:incoming>Flow15</bpmn:incoming>
      <bpmn:outgoing>Flow17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fim" name="Funcionalidade entregue">
      <bpmn:incoming>Flow17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow0" sourceRef="inicio" targetRef="solicitar" name="" />
    <bpmn:sequenceFlow id="Flow1" sourceRef="solicitar" targetRef="receber" name="" />
    <bpmn:sequenceFlow id="Flow2" sourceRef="receber" targetRef="documentar" name="" />
    <bpmn:sequenceFlow id="Flow3" sourceRef="documentar" targetRef="desenvolver" name="" />
    <bpmn:sequenceFlow id="Flow4" sourceRef="desenvolver" targetRef="commit" name="" />
    <bpmn:sequenceFlow id="Flow5" sourceRef="commit" targetRef="verificar" name="" />
    <bpmn:sequenceFlow id="Flow6" sourceRef="verificar" targetRef="aprovado" name="" />
    <bpmn:sequenceFlow id="Flow7" sourceRef="aprovado" targetRef="bloquear" name="Não" />
    <bpmn:sequenceFlow id="Flow8" sourceRef="bloquear" targetRef="corrigir" name="" />
    <bpmn:sequenceFlow id="Flow9" sourceRef="corrigir" targetRef="commit" name="Novo envio" />
    <bpmn:sequenceFlow id="Flow10" sourceRef="aprovado" targetRef="pages" name="Sim" />
    <bpmn:sequenceFlow id="Flow11" sourceRef="pages" targetRef="habilitado" name="" />
    <bpmn:sequenceFlow id="Flow12" sourceRef="habilitado" targetRef="preparar" name="Sim" />
    <bpmn:sequenceFlow id="Flow13" sourceRef="habilitado" targetRef="sem_pages" name="Não" />
    <bpmn:sequenceFlow id="Flow14" sourceRef="preparar" targetRef="publicar" name="" />
    <bpmn:sequenceFlow id="Flow15" sourceRef="publicar" targetRef="monitorar" name="Sucesso" />
    <bpmn:sequenceFlow id="Flow16" sourceRef="erro" targetRef="falha" name="" />
    <bpmn:sequenceFlow id="Flow17" sourceRef="monitorar" targetRef="fim" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="0" y="110" width="1640" height="820" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane0_di" bpmnElement="Lane0" isHorizontal="true">
        <dc:Bounds x="20" y="110" width="1620" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane1_di" bpmnElement="Lane1" isHorizontal="true">
